__pycache__/
*.egg-info/
.venv/
.smritikosh/
*.pyc
.coverage
htmlcov/
build/
dist/
plan/
# Lock files are deliberately not committed: this is a library, so consumers
# resolve from the version ranges in pyproject.toml, and both tools regenerate
# these on demand.
uv.lock
poetry.lock
# Built indexes: large binaries, regenerable from source.
# .wal is DuckDB's write-ahead log, left behind if a write is interrupted.
*.duckdb
*.duckdb.wal
# Editor state: holds absolute paths from whichever machine opened the project.
.vscode/
# Logo scratch: discarded directions and rendered comparison sheets. The brand
# set that actually ships sits beside them in assets/logo/.
assets/logo/explorations/
assets/logo/previews/